{
  "name": "cloth-shop-erp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Shravani Collection & New SK Telors - Desktop ERP & POS",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:start": "electron .",
    "package:win": "npm run build && npx @electron/packager . ClothShopERP --platform=win32 --arch=x64 --out=dist-package --overwrite",
    "electron:build": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.clothshoperp.pos",
    "productName": "ClothShopERP",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cloth Shop ERP & POS"
    }
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.52.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
